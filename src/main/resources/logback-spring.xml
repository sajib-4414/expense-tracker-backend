<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Pull values from application.properties / application.yml -->
    <springProperty scope="context" name="DB_URL"      source="spring.datasource.url"/>
    <springProperty scope="context" name="DB_USERNAME"  source="spring.datasource.username"/>
    <springProperty scope="context" name="DB_PASSWORD"  source="spring.datasource.password"/>
    <springProperty scope="context" name="DB_DRIVER"    source="spring.datasource.driver-class-name"/>

    <property name="LOG_PATH" value="logs"/>

    <!-- ==================== CONSOLE ==================== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ==================== APP ROLLING FILE ==================== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/app.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ==================== DB ROLLING FILE ==================== -->
    <appender name="DB_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/db.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/db.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ==================== DB TABLE APPENDER ==================== -->



    <!-- ==================== LOGGERS ==================== -->

    <!-- Hibernate SQL -->
    <logger name="org.hibernate.SQL" level="DEBUG" additivity="true">
<!--        <appender-ref ref="DB_FILE"/>-->
        <appender-ref ref="ASYNC_DB_TABLE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Hibernate bind parameters -->
    <logger name="org.hibernate.orm.jdbc.bind" level="TRACE" additivity="true">
<!--        <appender-ref ref="DB_FILE"/>-->
        <appender-ref ref="ASYNC_DB_TABLE"/>
    </logger>

    <!-- Spring JDBC / transactions -->
    <logger name="org.springframework.jdbc" level="DEBUG" additivity="false">
<!--        <appender-ref ref="DB_FILE"/>-->
        <appender-ref ref="ASYNC_DB_TABLE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="org.springframework.orm.jpa" level="DEBUG" additivity="false">
<!--        <appender-ref ref="DB_FILE"/>-->
        <appender-ref ref="ASYNC_DB_TABLE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- Your repository/DAO layer — change package to yours -->
    <logger name="com.sajib_4414.expense.tracker.models" level="DEBUG" additivity="false">
<!--        <appender-ref ref="DB_FILE"/>-->
<!--        <appender-ref ref="ASYNC_DB_TABLE"/>-->
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- ==================== ROOT ==================== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>